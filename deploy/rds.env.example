#!/bin/bash
# ========== AiTripPlan 云部署环境变量模板 ==========
# 用法: cp deploy/rds.env.example /opt/aitripplan/rds.env 后填入真实值
# 注意: 本文件只含变量名占位，真实密钥【严禁】提交 git。.gitignore 已挡 rds.env
# 云端服务启动脚本 start-all.sh 会 source 本文件，所有 nohup 子进程继承

# ---- 数据库（云RDS / 本地MySQL） ----
export RDS_HOST="127.0.0.1:3306"          # 云RDS 例: rm-xxx.rwlb.cn-chengdu.rds.aliyuncs.com:3306
export RDS_USER="root"                      # 云RDS 用最小权限账号 trip_user
export RDS_PASSWORD="__填真实密码__"

# ---- 模型（java 主模型走 deepseek；fallback qwen 无key时自动跳过）----
export DEEPSEEK_API_KEY="__填真实key__"
export DASHSCOPE_API_KEY="__可选: fallback qwen 用__"
export MODEL_MAX_ITERS="15"
export MODEL_BASE_URL="https://api.deepseek.com"
export MODEL_API_KEY="__填真实key__"        # 与 DEEPSEEK_API_KEY 相同
export MODEL_NAME="deepseek-v4-flash"

# ---- 高德（采集 + MCP 查询）----
export AMAP_KEY="__填真实key__"
export AMAP_MCP_KEY="__填真实key__"         # 与 AMAP_KEY 相同（MCP 服务端用）

# ---- 百度 MCP（可选代理，无则留空）----
export BAIDU_MCP_URL=""

# ---- Nacos 技能（子Agent接线；版本与 scripts/nacos-init 发布一致）----
export SKILL_NAMES="route-making-skill,trip-planner-skill"
export SKILL_VERSION="0.0.1"
